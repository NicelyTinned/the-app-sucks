{
  "name": "the-app-sucks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create the-app-sucks-db",
    "db:migrate:local": "wrangler d1 migrations apply the-app-sucks-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply the-app-sucks-db --remote",
    "typecheck": "tsc --noEmit",
    "dev:frontend": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.552.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.45.0"
  }
}
